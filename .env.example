# Used by `docker compose up` — copy this to `.env` in this same folder
# and fill in real values. docker-compose.yml reads .env automatically;
# you do not need to pass these on the command line.

JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=https://your-production-domain.example

# Real OTP email delivery. Free option: a Gmail account with an
# "App Password" (Google Account > Security > 2-Step Verification >
# App passwords). Paid options (SendGrid/SES/Mailgun/Zoho) use the same
# shape, just swap the host/user/pass.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your16charapppassword
SMTP_FROM=SMArT Airway Training <youraccount@gmail.com>
