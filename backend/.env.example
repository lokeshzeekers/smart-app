# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://smart_user:smart_pass@localhost:5432/smart_airway
PGSSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# ESP32 device auth (devices authenticate with x-device-key header)
DEVICE_KEY_SALT_ROUNDS=10

# Email (for OTP delivery) - plug in real provider (SES/SendGrid) in production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=changeme
SMTP_FROM="SMArT Airway Training <no-reply@smart-airway.app>"
