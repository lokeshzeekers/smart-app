# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://smart_user:smart_pass@localhost:5432/smart_airway
PGSSL=false

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# ESP32 device auth (devices authenticate with x-device-key header)
DEVICE_KEY_SALT_ROUNDS=10

# Email (for OTP delivery)
# Free option: use a Gmail account with an "App Password"
#   1. Turn on 2-Step Verification on the Google account
#   2. Go to https://myaccount.google.com/apppasswords and create an app
#      password (name it e.g. "SMArT backend")
#   3. Use that 16-character password below as SMTP_PASS (not the normal
#      Gmail password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM="SMArT Airway Training <youraccount@gmail.com>"
#
# Paid/production option: swap in SendGrid, SES, Mailgun, Zoho etc. — same
# SMTP_HOST/PORT/USER/PASS shape, no code changes needed.
# If SMTP_* is left unset, OTP codes are printed to the server console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SMArT Airway Training <no-reply@smart-airway.app>"
