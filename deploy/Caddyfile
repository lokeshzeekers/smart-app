# Edge server: automatic HTTPS (Let's Encrypt), serves the app, proxies the API.
# One origin for everything, so the app works from any domain without a rebuild and
# the PWA install prompt works (browsers only allow installs / service workers over HTTPS).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# API, live socket and health check -> backend container (WebSockets are handled automatically)
	@backend path /api/* /socket.io/* /health
	handle @backend {
		reverse_proxy backend:4000
	}

	# Everything else -> the built app (single-page app: unknown paths open index.html)
	handle {
		root * /srv

		# Default (the "?" means: only if nothing below sets it): never cache. index.html (also served for deep links like /trainee/coach),
		# sw.js and the manifest must always be re-checked, or phones keep an old version of
		# the app - and the old hashed files no longer exist after a deploy (blank screen).
		header ?Cache-Control "no-cache"

		# Hashed build files never change; icons rarely do
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@icons path /icons/*
		header @icons Cache-Control "public, max-age=86400"

		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"

		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
