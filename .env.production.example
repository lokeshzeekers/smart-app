# Copy to ".env" on the server (same folder as docker-compose.prod.yml) and fill in.
# .env is git-ignored - never commit it.

# Your domain. Its DNS "A" record must already point at this server.
DOMAIN=smart.example.com
# Email Let's Encrypt uses for certificate expiry notices
ACME_EMAIL=you@example.com

# Generate each with:  openssl rand -hex 32
# (hex only: the password is placed inside a connection URL)
POSTGRES_PASSWORD=
JWT_SECRET=

# Real OTP e-mail delivery (see backend/.env.example for the Gmail App Password steps).
# Left empty, OTP codes are only printed in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SMArT Airway Training <no-reply@example.com>"
